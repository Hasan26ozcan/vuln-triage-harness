# GPU-accelerated serving image for Stage 9 (real-time, RTX 4060 / CUDA).
#
# Builds llama-cpp-python from source with CUDA (GGML_CUDA) support so the
# GGUF checkpoint produced by Stage 8 quantization can be offloaded to the
# GPU instead of running CPU-only. Pairs with the `serving-gpu` service in
# docker-compose.yml, which requests a GPU device reservation.
#
# Build:  docker build -f serving/Dockerfile.gpu -t vuln-triage-serving:gpu .
# Run:    docker run --rm --gpus all -p 8000:8000 \
#           -v /host/path/to/model.gguf:/models/model.gguf:ro \
#           -e MODEL_PATH=/models/model.gguf \
#           vuln-triage-serving:gpu

# ---- Base image: CUDA devel (needed to compile llama-cpp-python) ----
# Must match the CUDA driver on the host. RTX 4060 works with CUDA 12.x
# drivers (>= 535). If `nvidia-smi` on the host reports an older driver,
# switch this tag to a matching 12.1/12.2 devel image.
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git python3-pip python3.11 python3.11-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Compile llama-cpp-python with CUDA support (GGML_CUDA=on). This is the
# step that gives you *real* GPU inference instead of CPU fallback — a
# plain `pip install llama-cpp-python` installs the CPU-only wheel.
ENV CMAKE_ARGS="-DGGML_CUDA=on" \
    FORCE_CMAKE=1

RUN python3.11 -m pip install --upgrade pip && \
    python3.11 -m pip install "llama-cpp-python>=0.2.90" --no-cache-dir --verbose

# ---- Runtime stage: smaller image, CUDA runtime (not devel) ----
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libgomp1 python3-pip python3.11 \
    && rm -rf /var/lib/apt/lists/*

# Bring over the CUDA-compiled llama-cpp-python wheel + its site-packages.
COPY --from=builder /usr/lib/python3.11 /usr/lib/python3.11
COPY --from=builder /usr/local/lib/python3.11 /usr/local/lib/python3.11

WORKDIR /app

# Project code + serving-only deps (no torch/trl/peft needed to *serve*
# a GGUF checkpoint — those are training-time deps).
COPY app ./app
COPY pyproject.toml ./
# Non-root runtime user. All installs above run as root (needed to write
# into system site-packages); the server itself only needs read access to
# /app and the read-only /models mount, so drop privileges before CMD.
RUN python3.11 -m pip install fastapi httpx pydantic pydantic-settings typer "uvicorn[standard]" \
    && chmod +x ./app/serving/entrypoint.sh \
    && useradd --uid 1000 --create-home --shell /usr/sbin/nologin appuser \
    && chown -R appuser:appuser /app
USER appuser

# --- Runtime env, overridable via `docker run -e` / compose `environment:` ---
ENV MODEL_PATH=/models/model.gguf \
    BACKEND_TYPE=llama.cpp \
    N_GPU_LAYERS=-1 \
    NUM_CTX=4096 \
    HOST=0.0.0.0 \
    PORT=8000

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
    CMD curl -f http://localhost:8000/healthz || exit 1

# `-1` n-gpu-layers = offload every layer to GPU (full real-time GPU inference).
# Note: no "serve" subcommand — Typer treats the single registered command
# as the default, so it is invoked directly via python -m app.serving.cli.
# Exec form (script + `exec` inside it) so signals are forwarded correctly;
# see entrypoint.sh for why this isn't a plain shell-form CMD.
CMD ["/app/serving/entrypoint.sh"]