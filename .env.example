# Environment variables for vuln-triage-harness
# Copy this file to .env and fill in the values for your deployment.

# --- PostgreSQL ---
POSTGRES_USER=vuln_triage
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=vuln_triage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MinIO / S3 ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=vuln_triage
MINIO_SECRET_KEY=change-me-in-production
AWS_REGION=us-east-1

# --- HuggingFace ---
HF_TOKEN=

# --- NVD API ---
NVD_API_KEY=

# --- OpenAI (for Tier 4 LLM judge) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Docker GPU ---
GGUF_MODEL_PATH=./output/quantized
GGUF_MODEL_FILE=model.gguf
N_GPU_LAYERS=-1
